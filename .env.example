# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════════════

# ── LiveKit Cloud ───────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Deepgram (STT & TTS) ───────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Groq (LLM) ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# ── Sarvam AI (STT & TTS) ──────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key
TTS_PROVIDER=sarvam
STT_PROVIDER=sarvam

# ── VoBiz / SIP Trunking ───────────────────────────────────────────────────
VOBIZ_SIP_TRUNK_ID=your_trunk_id
OUTBOUND_TRUNK_ID=your_outbound_trunk_id
VOBIZ_SIP_DOMAIN=your_domain.sip.vobiz.ai
VOBIZ_USERNAME=your_vobiz_username
VOBIZ_PASSWORD=your_vobiz_password
VOBIZ_OUTBOUND_NUMBER=+91XXXXXXXXXX
DEFAULT_TRANSFER_NUMBER=+91XXXXXXXXXX

# ── Supabase (Database) ─────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
